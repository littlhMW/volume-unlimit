<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VolumeBoost-Setup</AssemblyName>
    <RootNamespace>VolumeBoostSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\PerAppVolume\exvcicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\PerAppVolume.exe" LogicalName="VolumeBoostPayload.exe" />
    <EmbeddedResource Include="payload\ApplicationLoopback.dll" LogicalName="ApplicationLoopback.dll" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
